/* Styles for the main TUI */

Screen {

    /* for the main app*/

    overflow-y: scroll;

}

#tui-title {

    /* the title */

    color: #ffcc00;

    text-align: center;

}

#description {

    /* the description */

    color: #fffae6;

    text-align: center;

    margin-top: 2;

    border: solid #fffae6;

    padding: 1 2 1 2

}

#start-button {

    /* the button to start the training*/

    margin: 1 2 1 2;

    align: center middle;

}

#training-log {

    height: 10;

    margin: 1 2 1 2;

    border: solid #ffcc00;

}

.form-label {

    /* for the labels in form.py */

    padding: 1 2 1 2

}

Button {

    /* for all the buttons generally */

    margin: 0 5 0 5;

    background: #ffcc00;

}

Titles {

    /* for the TUI titles */

    height: auto;

    align: center middle;
}

ModelConfig {

    /* for the form.py component */

    margin: 2 2 2 2;

    height: auto;

}

